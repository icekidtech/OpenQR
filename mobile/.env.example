# OpenQR mobile environment variables (all EXPO_PUBLIC_ are inlined at build time)
# Copy to .env and fill in your real values.

# Backend API base URL
# - iOS simulator: http://localhost:8080
# - Android emulator: http://10.0.2.2:8080
# - Physical device: http://<your-lan-ip>:8080
# - Web: http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client IDs (from Google Cloud Console > Credentials)
# These must be listed in the backend's GOOGLE_CLIENT_IDS allow-list.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Apple Sign In
# Native (iOS): your app's bundle identifier (com.openqr.app)
# Web: your Apple Services ID (e.g. com.openqr.app.web)
EXPO_PUBLIC_APPLE_CLIENT_ID=com.openqr.app
EXPO_PUBLIC_APPLE_WEB_CLIENT_ID=com.openqr.app.web
