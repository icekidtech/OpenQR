# OpenQR backend configuration (copy to .env and adjust)
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openqr?sslmode=disable

# Required: secret used to sign session JWTs (use a long random string in prod)
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated OAuth audience allow-list (Google OAuth client IDs for
# Android, iOS and Web — the backend accepts ID tokens issued for any of these)
GOOGLE_CLIENT_IDS=

# Apple "Sign in with Apple" Services ID (the client ID issued to this app)
APPLE_CLIENT_ID=

# Comma-separated list of allowed browser origins for CORS (empty = allow all in dev)
CORS_ORIGINS=

# Token lifetimes (Go duration strings)
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
